<Window x:Class="RDAoficialST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RDAoficial"
        Width="680"
        Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        Background="Black">

    <Window.Resources>

        <!-- ===================================== -->
        <!-- ESTILO ANIMADO DOS BOTÕES -->
        <!-- ===================================== -->

        <Style x:Key="AnimatedButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="RenderTransformOrigin"
                    Value="0.5,0.5"/>

            <Setter Property="RenderTransform">

                <Setter.Value>

                    <ScaleTransform ScaleX="1"
                                    ScaleY="1"/>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1.03"
                                                Duration="0:0:0.10"/>

                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1.03"
                                                Duration="0:0:0.10"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.85"
                                                Duration="0:0:0.10"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1"
                                                Duration="0:0:0.10"/>

                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1"
                                                Duration="0:0:0.10"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.10"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>

                            <!-- CLIQUE -->
                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter Property="RenderTransform">

                                    <Setter.Value>

                                        <ScaleTransform ScaleX="0.96"
                                                        ScaleY="0.96"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ===================================== -->
        <!-- ESTILO DAS ABAS -->
        <!-- ===================================== -->

        <Style TargetType="TabItem">

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="FontSize"
            Value="12"/>

            <Setter Property="Padding"
            Value="12,6"/>

            <Setter Property="Margin"
            Value="4,0,4,0"/>

            <Setter Property="Background"
            Value="#151515"/>

            <Setter Property="BorderBrush"
            Value="#2A2A2A"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Grid>

                            <!-- ===================================== -->
                            <!-- ABA -->
                            <!-- ===================================== -->

                            <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            Opacity="0.92"
                            RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>

                                    <ScaleTransform ScaleX="1"
                                            ScaleY="1"/>

                                </Border.RenderTransform>

                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Header"/>

                            </Border>

                        </Grid>

                        <!-- ===================================== -->
                        <!-- TRIGGERS -->
                        <!-- ===================================== -->

                        <ControlTemplate.Triggers>

                            <!-- ===================================== -->
                            <!-- HOVER -->
                            <!-- ===================================== -->

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <!-- SCALE X -->
                                            <DoubleAnimation
                                        Storyboard.TargetName="TabBorder"
                                        Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                        To="1.05"
                                        Duration="0:0:0.12"/>

                                            <!-- SCALE Y -->
                                            <DoubleAnimation
                                        Storyboard.TargetName="TabBorder"
                                        Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                        To="1.05"
                                        Duration="0:0:0.12"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <!-- SCALE X -->
                                            <DoubleAnimation
                                        Storyboard.TargetName="TabBorder"
                                        Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                        To="1"
                                        Duration="0:0:0.12"/>

                                            <!-- SCALE Y -->
                                            <DoubleAnimation
                                        Storyboard.TargetName="TabBorder"
                                        Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                        To="1"
                                        Duration="0:0:0.12"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                                <!-- VISUAL HOVER -->
                                <Setter TargetName="TabBorder"
                                Property="Background"
                                Value="#242424"/>

                                <Setter TargetName="TabBorder"
                                Property="BorderBrush"
                                Value="#555555"/>

                            </Trigger>

                            <!-- ===================================== -->
                            <!-- ABA SELECIONADA -->
                            <!-- ===================================== -->

                            <Trigger Property="IsSelected"
                             Value="True">

                                <!-- VISUAL -->
                                <Setter TargetName="TabBorder"
                                Property="Background"
                                Value="Red"/>

                                <Setter TargetName="TabBorder"
                                Property="BorderBrush"
                                Value="Red"/>

                                <Setter TargetName="TabBorder"
                                Property="Opacity"
                                Value="1"/>

                                <!-- ANIMAÇÃO -->
                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <!-- POP SCALE X -->
                                            <DoubleAnimation
                                        Storyboard.TargetName="TabBorder"
                                        Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                        From="0.92"
                                        To="1"
                                        Duration="0:0:0.18"/>

                                            <!-- POP SCALE Y -->
                                            <DoubleAnimation
                                        Storyboard.TargetName="TabBorder"
                                        Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                        From="0.92"
                                        To="1"
                                        Duration="0:0:0.18"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ===================================== -->
        <!-- ESTILO TABCONTROL -->
        <!-- ===================================== -->

        <Style TargetType="TabControl">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabControl">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            <!-- ABAS -->
                            <TabPanel Grid.Row="0"
                                      Margin="0,0,0,10"
                                      IsItemsHost="True"
                                      Background="Transparent"/>

                            <!-- CONTEÚDO -->
                            <Border Grid.Row="1"
                                    Background="Transparent"
                                    CornerRadius="18"
                                    Padding="10"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Opacity="0.97">

                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="5"
                                                  ContentSource="SelectedContent"/>

                            </Border>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <!-- TOASTS -->
        <StackPanel x:Name="ToastContainer"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,15,15"
                Panel.ZIndex="999"/>


        <Image x:Name="fundo"
           Source="Assets/fundo2.jpg"
           Stretch="Fill"
           Opacity="0.45"
           RenderTransformOrigin="0.5,0.5">

            <Image.RenderTransform>
                <ScaleTransform x:Name="FundoScale"/>
            </Image.RenderTransform>

        </Image>

        <Canvas x:Name="ParticleCanvas"
            IsHitTestVisible="False"/>

        <!-- OVERLAY -->
        <Border Background="#88000000"/>

        <StackPanel HorizontalAlignment="Center"
                        Margin="0,42,0,25">

            <!-- REDES SOCIAIS -->
            <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="-30,10,0,0">

                <!-- YOUTUBE -->
                <Button Width="40"
                            Height="40"
                            Margin="0,0,5,0"
                            Background="Transparent"
                            Style="{StaticResource AnimatedButtonStyle}"
                            Click="BtnYoutube_Click">

                    <StackPanel>

                        <Image Source="Assets/youtube.png"
                                   Width="30"
                                   Height="41"/>

                    </StackPanel>

                </Button>

            </StackPanel>

            <Grid Width="120"
      Height="120"
      Margin="0,-95,0,0">

                <!-- LOGO NORMAL -->
                <Image Source="Assets/logo.png"
           Width="120"
           Height="120"/>

                <!-- LOGO COM BRILHO -->
                <Image x:Name="LogoGlow"
           Source="Assets/logo.png"
           Width="120"
           Height="120"
           Opacity="0">

                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoScale"/>
                    </Image.RenderTransform>

                    <Image.RenderTransformOrigin>
                        0.5,0.5
                    </Image.RenderTransformOrigin>

                    <Image.Effect>
                        <DropShadowEffect
                Color="Red"
                BlurRadius="40"
                ShadowDepth="0"
                Opacity="0.85"/>
                    </Image.Effect>

                </Image>

            </Grid>

            <!-- TITULO -->
            <TextBlock x:Name="TituloRDA"
           Text="RDAoficial"
           FontSize="42"
           FontWeight="Bold"
           HorizontalAlignment="Center">

                <TextBlock.Effect>
                    <DropShadowEffect
            Color="#FFFFB0B0"
            BlurRadius="25"
            ShadowDepth="0"
            Opacity="0.8"/>
                </TextBlock.Effect>

                <TextBlock.Foreground>

                    <LinearGradientBrush x:Name="TituloBrush"
                             StartPoint="0,0"
                             EndPoint="1,0">

                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="TituloGradientTransform"/>
                        </LinearGradientBrush.RelativeTransform>

                        <GradientStop Color="Red" Offset="0.00"/>
                        <GradientStop Color="Red" Offset="0.25"/>
                        <GradientStop Color="#FFFF8080" Offset="0.40"/>
                        <GradientStop Color="#FFFFFF" Offset="0.50"/>
                        <GradientStop Color="#FFFF8080" Offset="0.60"/>
                        <GradientStop Color="Red" Offset="0.75"/>
                        <GradientStop Color="Red" Offset="1.00"/>

                    </LinearGradientBrush>

                </TextBlock.Foreground>

            </TextBlock>

            <!-- SUB -->
            <TextBlock Text="(Ferramenta oficial.)"
                           FontSize="14"
                           Foreground="#FFF90303"
                           Margin="0,0,0,25"
                           HorizontalAlignment="Center"/>

            <!-- TAB CONTROL -->
            <TabControl Width="580"
                            Height="420"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14">


                <!-- =========================== -->
                <!-- ABA PACOTE JOGOS -->
                <!-- =========================== -->


                <TabItem Header="Pacote de jogos" Margin="65,0,-70,0">
                    <Grid Margin="15">
                        <Border Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="18"
                Padding="25" Margin="0,-45,0,-17">
                            <StackPanel VerticalAlignment="Center">

                                <Image
                                    Source="Assets/111.ico"
                                    Width="107"
                                    Height="134"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,15"/>

                                <TextBlock Text="Pacotão +200 jogos"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="ExtraBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                                <TextBlock Text="Compre vários jogos de uma vez só."
                           Foreground="#CCCCCC"
                           FontSize="13"
                           TextAlignment="Center"
                           Margin="0,0,0,25"/>

                                <Button
                                    Content="Comprar Pacote"
                                    Background="Red"
                                    Style="{StaticResource AnimatedButtonStyle}"
                                    Click="BtnInstalarPacote_Click"
                                    Width="220"
                                    Height="45"
                                    Margin="0,10,0,0"/>


                                <TextBlock x:Name="TxtStatusPacote"
                           Text="Pronto para Instalar."
                           Foreground="#CCCCCC"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0" Height="35"/>

                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>



                <!-- =========================== -->
                <!-- ABA BACKUP -->
                <!-- =========================== -->

                <TabItem Header="Backups" Margin="74,0,-107,0" RenderTransformOrigin="0.5,0.5">
                    <TabItem.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.975" ScaleY="0.975"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TabItem.RenderTransform>

                    <StackPanel Margin="15">

                        <TextBlock Text="Backup da Biblioteca (.luas)"
                                       FontSize="18"
                                       FontWeight="ExtraBold"
                                       Foreground="White"
                                       Margin="0,0,0,12"
                                       HorizontalAlignment="Center"/>

                        <Button Content="Backup Automático"
                                    Width="320"
                                    Height="38"
                                    Margin="0,0,0,10"
                                    Background="Red"
                                    Style="{StaticResource AnimatedButtonStyle}"
                                    Click="BtnBackup_Click" Foreground="White"/>

                        <Button Content="Restauração Automática"
                                    Width="320"
                                    Height="38"
                                    Margin="0,0,0,10"
                                    Background="Red"
                                    Style="{StaticResource AnimatedButtonStyle}"
                                    Click="BtnRestore_Click"/>


                        <TextBlock Text="Backup das Conquistas"
                           FontSize="18"
                           FontWeight="ExtraBold"
                           Foreground="White"
                           Margin="0,0,0,12"
                           HorizontalAlignment="Center"/>


                        <Button Content="Backup Automatico"
                                    Width="320"
                                    Height="38"
                                    Margin="0,0,0,10"
                                    Background="Red"
                                    Style="{StaticResource AnimatedButtonStyle}"
                                    Click="BtnBackupconq_Click"/>

                        <Button Content="Restauração Automatica"
                                    Width="320"
                                    Height="38"
                                    Margin="0,0,0,30"
                                    Background="Red"
                                    Style="{StaticResource AnimatedButtonStyle}"
                                    Click="BtnRestoreconq_Click"/>

                    </StackPanel>

                </TabItem>

                <!-- =========================== -->
                <!-- ABA LUA TOOLS -->
                <!-- =========================== -->

                <TabItem Header="Lua Tools"
         Margin="111,0,-136,0">

                    <Grid Margin="15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>


                        <!-- ================================= -->
                        <!-- INSTALADOR -->
                        <!-- ================================= -->

                        <Border
                Margin="102,0,91,-18"
                Padding="15"
                CornerRadius="15"
                Background="Transparent"
                BorderThickness="1" Grid.ColumnSpan="2">

                            <StackPanel Margin="-106,-38,-94,-41">

                                <Image Source="Assets/luaapp.png"
                       Width="269"
                       Height="193"
                       />

                                <TextBlock Text="App Lua Tools!"
                           FontSize="18"
                           FontWeight="ExtraBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" Height="28" Width="140"/>

                                <TextBlock Text="Baixe o App (oficial) do Lua Tools."
                           TextAlignment="Center"
                           Foreground="#BBBBBB"
                           FontSize="11"
                           Margin="0,0,0,18"/>

                                <Button Content="Download"
                        Width="190"
                        Height="38"
                        Background="#FFEF00FC"
                        Style="{StaticResource AnimatedButtonStyle}"
                        Click="BtnSalvarLuaInstaller_Click"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </TabItem>



                <!-- =========================== -->
                <!-- ABA CORREÇÕES -->
                <!-- =========================== -->

                <TabItem Header="Fixes Games"
                    Margin="142,0,-169,0">

                    <Grid Height="423">


                        <Button Content="Tutorial OnlineFix"
                        Margin="326,238,114,145"
                        Background="#FF0000"
                        Style="{StaticResource AnimatedButtonStyle}"
                        Click="BtnTutorialonlinefix_Click"/>


                        <Button Content="Tutorial RyuuFix"
                        Margin="114,238,330,145"
                        Background="#FF0000"
                        Style="{StaticResource AnimatedButtonStyle}"
                        Click="BtnTutorialryuufix_Click"/>


                        <!-- DESCRIÇÃO -->
                        <TextBlock Text="Tutoriais de instalação (em video) abaixo."
                        Foreground="#BBBBBB"
                        FontSize="12"
                        TextAlignment="Center"
                        Margin="64,213,64,190"
                        Width="420"/>


                        <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" Height="342" Width="574">

                            <!-- IMAGEM -->

                            <!-- TITULO -->
                            <TextBlock Text="Correções para Games Offline/Online"
                       FontSize="17"
                       FontWeight="ExtraBold"
                       Foreground="White"
                       Margin="0,0,0,15"
                       HorizontalAlignment="Center" Height="30"/>

                            <!-- DESCRIÇÃO -->
                            <TextBlock Text="Correções para games offline e online!"
                       Foreground="#BBBBBB"
                       FontSize="12"
                       TextAlignment="Center"
                       Margin="0,0,0,25"
                       Width="420"/>


                            <!-- BOTÃO -->
                            <Button Content="Ryuu Fixes"
                    Width="200"
                    Height="35"
                    Background="Red"
                    Style="{StaticResource AnimatedButtonStyle}"
                    Click="BtnRyuufix_Click"/>


                            <Button Content="OnlineFix"
                    Width="200"
                    Height="35"
                    Margin="0,10,0,0"
                    Background="Red"
                    Style="{StaticResource AnimatedButtonStyle}"
                    Click="BtnOnlineFix_Click"/>


                        </StackPanel>


                    </Grid>

                </TabItem>


            </TabControl>


        </StackPanel>

        <TextBlock Text="RDAoficial™ • © 2026 • Todos os direitos reservados"
           Foreground="Red"
           FontSize="11"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="0,655,0,0"/>


        <TextBlock Text="Sobre"
           FontSize="13"
           Foreground="Red"
           Cursor="Hand"
           HorizontalAlignment="Right"
           VerticalAlignment="Top"
           Margin="0,10,15,0"
           MouseLeftButtonUp="TxtSobre_Click">

            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Opacity" Value="1.8"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>

        </TextBlock>

    </Grid>

</Window>